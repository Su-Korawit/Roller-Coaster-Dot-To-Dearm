# Copy to .env and fill in values. Vite inlines VITE_* at build time — set the same
# names in Vercel (Production + Preview) before deploying.

VITE_GEMINI_API_KEY=
VITE_GOOGLE_MAPS_KEY=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_URL=

VITE_SLIPOK_API_KEY=
VITE_PROMPTPAY_NUMBER=
VITE_MERCHANT_NAME=
VITE_PAYMENT_EXPIRE_MINUTES=15

# Spotify Developer Dashboard → app Client ID (PKCE, no secret).
# Register redirect URIs: http://127.0.0.1:5173/music/callback and https://<prod>/music/callback
VITE_SPOTIFY_CLIENT_ID=
