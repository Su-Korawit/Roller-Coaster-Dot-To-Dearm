# Copy to .env and fill in values. Vite inlines VITE_* at build time — set the same
# names in Vercel (Production + Preview) before deploying.

VITE_GEMINI_API_KEY=
VITE_GOOGLE_MAPS_KEY=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_URL=

VITE_SLIPOK_API_KEY=
VITE_PROMPTPAY_NUMBER=
VITE_MERCHANT_NAME=
VITE_PAYMENT_EXPIRE_MINUTES=15

# Spotify Developer Dashboard → app Client ID (PKCE, no secret).
# Register redirect URIs: http://127.0.0.1:5173/music/callback and https://<prod>/music/callback
VITE_SPOTIFY_CLIENT_ID=

# ── Voice secretary "พี่ใจดี" (Retell) — SERVER-ONLY, never prefix with VITE_ ──
RETELL_API_KEY=
RETELL_AGENT_ID=agent_10815e6801c2626ecef1cb22ae
RETELL_FROM_NUMBER=+13192641997
# your OWN number only (testing). Outbound is restricted to this number unless DIAL_ONLY_TEST_PHONE=false
TEST_PHONE_OWN=
DIALING_ENABLED=false
DIAL_ONLY_TEST_PHONE=true
CRON_SECRET=
FIREBASE_SERVICE_ACCOUNT=
# ceilings (optional; defaults in api/_voice/logic.js)
VOICE_TRIAL_WEB_SECONDS=600
VOICE_TRIAL_WEB_SECONDS_PER_DAY=300
VOICE_PAID_WEB_SECONDS_PER_DAY=900
VOICE_WEB_CALL_SECONDS=180
VOICE_PHONE_CALLS_PER_DAY=1
VOICE_PHONE_CALL_SECONDS=300
VOICE_GLOBAL_DAILY_CALLS=20
VOICE_GLOBAL_DAILY_SECONDS=3600
