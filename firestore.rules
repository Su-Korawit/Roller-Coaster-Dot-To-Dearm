rules_version = '2';

// NOTE: These rules mirror the app's CURRENT access patterns (read
// src/stores/useSocialStore.js + chat store before changing them). They were
// authored to bring rules under version control — REVIEW and diff against the
// live console rules before `firebase deploy --only firestore:rules`.
//
// Why `list` is signed-in (not admin-only): social search (searchUsers),
// nearby (loadNearbyUsers) and matched (loadMatchedUsers) all query the
// `users` collection as a regular user, so restricting list to admin would
// break those features. The admin analytics dashboard reads the same
// collection — no extra rule needed.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    // Super-admin: the developer account, gated by UID (the most sensitive ops —
    // user create/delete — stay UID-only).
    function isSuperAdmin() {
      return isSignedIn() && request.auth.uid == 'IaltEhO0mPVfK3ng8npr4CdqnEE3';
    }
    // Section-scoped admins are gated by token email (verified for Google sign-in).
    // Mirror of ADMIN_ROLES in src/constants/admin.js — keep both in sync.
    function userEmail() {
      return isSignedIn() ? request.auth.token.email : '';
    }
    function canEditMaps() {
      return isSuperAdmin() || userEmail() == 'takadaoni07@gmail.com';
    }
    function canEditMusic() {
      return isSuperAdmin() || userEmail() == 'itcity9476@gmail.com';
    }
    // Shop catalog + Finance are super-admin only.
    function canEditShop() {
      return isSuperAdmin();
    }
    function isAnyAdmin() {
      return isSuperAdmin()
        || userEmail() == 'o.korawitt@gmail.com'
        || userEmail() == 'takadaoni07@gmail.com'
        || userEmail() == 'play198725@gmail.com'
        || userEmail() == 'itcity9476@gmail.com';
    }

    match /users/{uid} {
      allow get, list: if isSignedIn();
      // A new doc may not seed the Functions-owned study-room fields.
      allow create: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin()) &&
        !request.resource.data.keys().hasAny(['leaves', 'roomInventory', 'welcomePack', 'practiceRewarded', 'focusBySubject', 'avatar']);
      // Owners may update their own doc freely EXCEPT the `coins`,
      // `entitlements`, `fileBagUsageBytes`, `focusXp`, `teacherSchoolId`, `leaves`,
      // `roomInventory` and `welcomePack` fields — those are
      // written only by Cloud Functions (Admin SDK bypasses rules). Cross-user
      // updates are restricted to ONLY the four social array fields.
      allow update: if isSignedIn() && (
        (request.auth.uid == uid &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['coins', 'entitlements', 'fileBagUsageBytes', 'focusXp', 'teacherSchoolId',
                      'leaves', 'roomInventory', 'welcomePack', 'practiceRewarded', 'focusBySubject', 'avatar'])) ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['followRequests', 'followers', 'following', 'sentRequests'])
      );
      allow delete: if isSuperAdmin();

      // Match results are private to the owning user.
      match /matches/{targetUid} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      // Private per-user documents (e.g. Spotify refresh token) — owner only.
      // Must NOT live at the top level: user docs are get/list-readable by any
      // signed-in user, which would leak the token. See docs/adr/0010.
      match /private/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    match /chats/{chatId} {
      allow read:   if isSignedIn() && request.auth.uid in resource.data.members;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.members;
      allow update: if isSignedIn() && request.auth.uid in resource.data.members;

      match /messages/{messageId} {
        function chatMembers() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
        allow read:   if isSignedIn() && request.auth.uid in chatMembers();
        allow create: if isSignedIn() && request.auth.uid in chatMembers();
      }
    }

    // Asset folder registry (tilesets, objects, custom folders for sprites).
    // Admin-only read/write — maps admin manages asset folders via Admin Dashboard.
    match /assetFolders/{folderId} {
      allow read:  if canEditMaps();
      allow write: if canEditMaps();
    }

    // Per-map runtime config (tileset→Storage mapping, per-layer collision).
    // World-readable so the game can boot for anyone; the super-admin and the
    // Maps-section admin edit it via the Admin Dashboard.
    match /mapConfigs/{key} {
      allow read:  if true;
      allow write: if canEditMaps();
    }

    // Background-music track list. World-readable (HomePage needs it to boot);
    // the super-admin and the Music-section admin edit it.
    match /musicConfig/{doc} {
      allow read:  if true;
      allow write: if canEditMusic();
    }

    // Welcome / landing page content. World-readable (the landing page is public,
    // even for unauthenticated visitors); only the super-admin edits it via the
    // Admin Dashboard. Recursive so the news/faq/testimonials subcollections inherit.
    match /welcomeConfig/{document=**} {
      allow read:  if true;
      allow write: if isSuperAdmin();
    }

    // Shop catalog: signed-in users read active products; super-admin manages.
    match /shopProducts/{productId} {
      allow read:  if isSignedIn();
      allow write: if canEditShop();
    }

    // Purchases are written exclusively by Cloud Functions (Admin SDK).
    // Clients may read only their own purchase or super-admin reads any.
    // No client create/update/delete — Functions own this collection.
    match /purchases/{purchaseId} {
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid || isSuperAdmin()
      );
    }

    // Legacy Personal Map documents (removed with the farm, ADR-0023). Read-only until the owner
    // runs scripts/purgeLegacyWorld.mjs, which deletes them with the Admin SDK.
    match /maps/{ownerUid} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // Roadmap Sheets — one document per user-created canvas. Owner has full
    // control; an 'edit' collaborator may write nodes/edges but can never
    // touch ownerUid/collaborators/collaboratorUids (no self-promotion, no
    // adding other collaborators); a 'view' collaborator gets read-only.
    match /roadmapSheets/{sheetId} {
      function isSheetOwner() {
        return isSignedIn() && request.auth.uid == resource.data.ownerUid;
      }
      function isSheetCollaborator() {
        return isSignedIn() && request.auth.uid in resource.data.collaborators;
      }
      // Read/list must key off collaboratorUids — the same field as
      // queries.sheetsSharedWithMe (array-contains). Rules cannot prove
      // collaboratorUids stays in sync with the collaborators map.
      function canReadSheet() {
        return isSheetOwner() ||
          (isSignedIn() && request.auth.uid in resource.data.get('collaboratorUids', [])) ||
          resource.data.get('public', false) == true;
      }
      function isEditCollaborator() {
        return isSheetCollaborator() && resource.data.collaborators[request.auth.uid] == 'edit';
      }

      allow read: if canReadSheet() || (sheetId == 'admin-idea-board' && isAnyAdmin());
      allow create: if (isSignedIn() && request.auth.uid == request.resource.data.ownerUid)
        || (sheetId == 'admin-idea-board' && isAnyAdmin());
      allow update: if isSheetOwner() ||
        (isEditCollaborator() &&
          resource.data.ownerUid == request.resource.data.ownerUid &&
          resource.data.collaborators == request.resource.data.collaborators &&
          resource.data.collaboratorUids == request.resource.data.collaboratorUids &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['public', 'shareId']))
        || (sheetId == 'admin-idea-board' && isAnyAdmin());
      allow delete: if isSheetOwner();
    }

    // Slip dedup ledger: server-only (no client access at all).
    match /usedSlips/{transRef} {
      allow read, write: if false;
    }

    // Admin-curated content feeds: app updates (News tab) and TCAS calendar
    // events. World-readable — the public news Feature site
    // (news.ilovetcas.com, ADR-0012) renders both feeds without a session.
    // Only the super-admin writes (in-panel forms gate on ADMIN_UID
    // client-side; these rules are the real gate).
    match /appUpdates/{updateId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    // School directory: { name, memberCount } maintained by the syncUserSchool
    // Cloud Function (ADR 0018). Clients read memberCount to pick a presence room.
    match /schools/{schoolId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Study Room. The catalog is public to signed-in users and admin-edited; a room layout is
    // written ONLY by the saveRoomLayout function (rules cannot count copies per item, so the
    // function validates the layout against the owner's inventory).
    match /roomCatalog/{itemId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
    match /rooms/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Focus sessions (ADR 0018): written only by the startFocus/checkInFocus/
    // endFocus Cloud Functions. Owners may read their own records.
    match /focusActive/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /focusDaily/{docId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /focusSessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // School announcement board (ADR 0018). Members of a school read; only a verified
    // teacher of THAT school (custom claims set by grantTeacherBadge) may post.
    match /schoolBoards/{schoolId}/posts/{postId} {
      function isMemberOfSchool() {
        return isSignedIn() &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId;
      }
      function isTeacherHere() {
        return isSignedIn() && request.auth.token.teacher == true &&
          request.auth.token.teacherSchoolId == schoolId;
      }
      allow read: if isMemberOfSchool() || isTeacherHere() || isSuperAdmin();
      allow create: if isTeacherHere()
        && request.resource.data.keys().hasOnly(['title', 'body', 'authorUid', 'authorName', 'schoolId', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.schoolId == schoolId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
        && request.resource.data.body is string && request.resource.data.body.size() <= 1000
        && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 60
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isSuperAdmin() || (isTeacherHere() && resource.data.authorUid == request.auth.uid);
    }

    // Erasure log (PDPA): written only by deleteMyAccount, never readable by clients.
    match /accountDeletions/{docId} {
      allow read, write: if false;
    }

    // Weekly school leaderboard (ADR 0018): school-level aggregates only, no
    // personal data, so it is public (shareable / SEO). Written by rollupSchoolWeek.
    match /schoolWeeks/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /leaderboardMeta/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Content site (spec 2026-10-16-content-site-design.md) ────────────────
    // Creator = custom claim set by grantCreatorRole. Creators write only drafts;
    // the public `articles` collection is written solely by the publishArticle /
    // unpublishArticle Cloud Functions (Admin SDK bypasses these rules), so a
    // half-edited draft can never go live and slugs cannot be hijacked.
    function isCreator() {
      return isSignedIn() && request.auth.token.get('creator', false) == true;
    }
    function draftFields() {
      return ['authorUid', 'authorName', 'title', 'slug', 'category', 'excerpt', 'tags',
              'coverUrl', 'coverAlt', 'body', 'seo', 'publishedSlug', 'publishedAt',
              'isLive', 'liveUpdatedAt', 'createdAt', 'updatedAt'];
    }

    match /articles/{slug} {
      allow read: if true;
      allow write: if false;
    }

    match /articleDrafts/{draftId} {
      allow read: if isSuperAdmin()
        || (isCreator() && resource.data.authorUid == request.auth.uid);
      allow create: if isSuperAdmin()
        || (isCreator()
            && request.resource.data.authorUid == request.auth.uid
            && !('publishedSlug' in request.resource.data)
            && !('publishedAt' in request.resource.data)
            && !('isLive' in request.resource.data)
            && !('liveUpdatedAt' in request.resource.data)
            && request.resource.data.keys().hasOnly(draftFields()));
      allow update: if isSuperAdmin()
        || (isCreator()
            && resource.data.authorUid == request.auth.uid
            && request.resource.data.authorUid == resource.data.authorUid
            && request.resource.data.get('publishedSlug', null) == resource.data.get('publishedSlug', null)
            && request.resource.data.get('publishedAt', null) == resource.data.get('publishedAt', null)
            && request.resource.data.get('isLive', null) == resource.data.get('isLive', null)
            && request.resource.data.get('liveUpdatedAt', null) == resource.data.get('liveUpdatedAt', null)
            && request.resource.data.keys().hasOnly(draftFields()));
      allow delete: if isSuperAdmin()
        || (isCreator()
            && resource.data.authorUid == request.auth.uid
            && resource.data.get('publishedSlug', '') == '');
    }

    // Hub settings (LINE OpenChat info, featured article): public read, super-admin write.
    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /tcasEvents/{eventId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Community timetable templates: any student publishes their own timetable
    // (createdBy must be themselves); templates are immutable once published;
    // delete own or super-admin (moderation).
    match /timetableTemplates/{templateId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() &&
        (resource.data.createdBy == request.auth.uid || isSuperAdmin());
    }

    // Entitlement catalog — priced unlockables. Signed-in read; super-admin
    // writes (pricing experiments without a deploy). Purchases themselves are
    // executed only by the purchaseEntitlement Cloud Function (Admin SDK).
    match /entitlementCatalog/{itemId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // File Bag — personal file manager (ADR-0016). Owner-only read/write.
    match /fileBagItems/{itemId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /fileBagFolders/{folderId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Per-user Bag UI prefs (visible left-rail categories).
    match /bagSettings/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
    // Voice secretary (Retell). Written ONLY by the Admin SDK in /api/voice/* — consent,
    // quota, phone and paid flags must never be client-writable. Users may read their own doc.
    match /voiceSecretary/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /voiceGlobal/{day} {
      allow read, write: if false;
    }
  }
}
