rules_version = '2';

// NOTE: These rules mirror the app's CURRENT access patterns (read
// src/stores/useSocialStore.js + chat store before changing them). They were
// authored to bring rules under version control — REVIEW and diff against the
// live console rules before `firebase deploy --only firestore:rules`.
//
// Why `list` is signed-in (not admin-only): social search (searchUsers),
// nearby (loadNearbyUsers) and matched (loadMatchedUsers) all query the
// `users` collection as a regular user, so restricting list to admin would
// break those features. The admin analytics dashboard reads the same
// collection — no extra rule needed.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    // Super-admin: the developer account, gated by UID (the most sensitive ops —
    // user create/delete — stay UID-only).
    function isSuperAdmin() {
      return isSignedIn() && request.auth.uid == 'IaltEhO0mPVfK3ng8npr4CdqnEE3';
    }
    // Section-scoped admins are gated by token email (verified for Google sign-in).
    // Mirror of ADMIN_ROLES in src/constants/admin.js — keep both in sync.
    function userEmail() {
      return isSignedIn() ? request.auth.token.email : '';
    }
    function canEditMaps() {
      return isSuperAdmin() || userEmail() == 'takadaoni07@gmail.com';
    }
    function canEditMusic() {
      return isSuperAdmin() || userEmail() == 'itcity9476@gmail.com';
    }
    // Shop catalog + Finance are super-admin only.
    function canEditShop() {
      return isSuperAdmin();
    }

    match /users/{uid} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      // Owners may update their own doc freely EXCEPT the `coins` field — that
      // is written only by Cloud Functions (Admin SDK bypasses rules). Cross-user
      // updates are restricted to ONLY the four social array fields.
      allow update: if isSignedIn() && (
        (request.auth.uid == uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins'])) ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['followRequests', 'followers', 'following', 'sentRequests'])
      );
      allow delete: if isSuperAdmin();

      // Match results are private to the owning user.
      match /matches/{targetUid} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    match /chats/{chatId} {
      allow read:   if isSignedIn() && request.auth.uid in resource.data.members;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.members;
      allow update: if isSignedIn() && request.auth.uid in resource.data.members;

      match /messages/{messageId} {
        function chatMembers() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
        allow read:   if isSignedIn() && request.auth.uid in chatMembers();
        allow create: if isSignedIn() && request.auth.uid in chatMembers();
      }
    }

    // Per-map runtime config (tileset→Storage mapping, per-layer collision).
    // World-readable so the game can boot for anyone; the super-admin and the
    // Maps-section admin edit it via the Admin Dashboard.
    match /mapConfigs/{key} {
      allow read:  if true;
      allow write: if canEditMaps();
    }

    // Background-music track list. World-readable (HomePage needs it to boot);
    // the super-admin and the Music-section admin edit it.
    match /musicConfig/{doc} {
      allow read:  if true;
      allow write: if canEditMusic();
    }

    // Shop catalog: signed-in users read active products; super-admin manages.
    match /shopProducts/{productId} {
      allow read:  if isSignedIn();
      allow write: if canEditShop();
    }

    // Purchases are written exclusively by Cloud Functions (Admin SDK).
    // Clients may read only their own purchase or super-admin reads any.
    // No client create/update/delete — Functions own this collection.
    match /purchases/{purchaseId} {
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid || isSuperAdmin()
      );
    }

    // Slip dedup ledger: server-only (no client access at all).
    match /usedSlips/{transRef} {
      allow read, write: if false;
    }
  }
}
